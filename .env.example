# ---- Database -----------------------------------------------------------
# Dev (zero setup): SQLite via schema.sqlite.prisma (`npm run db:push`)
# Prod: Neon Postgres free tier (https://neon.tech) + `npm run db:push:pg`
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---- App ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- Email (weekly digests + alerts) ------------------------------------
# Free tier: resend.com (3,000 emails/mo). Unset = emails are logged, not sent.
# RESEND_API_KEY="re_..."
# MAIL_FROM="DmarcDuck <duck@yourdomain.com>"

# ---- Scheduled digest job ------------------------------------------------
# Bearer secret required by /api/cron/digest (Vercel Cron / GitHub Actions).
# CRON_SECRET="generate-a-long-random-string"

# ---- Billing (Lemon Squeezy, merchant of record) -------------------------
# Store plan: Starter/Studio. Webhook -> /api/webhooks/lemonsqueezy
# LS_SIGNATURE_SECRET="..."

# ---- Deployment ----------------------------------------------------------
# Vercel recommended. Set all env vars in the Vercel dashboard.
